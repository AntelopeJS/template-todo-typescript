{
  "name": "antelopejs-module",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ajs project run -w",
    "test": "ajs module test",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync --profile template",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check --profile template",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.7 <1.0.0",
    "@antelopejs/interface-auth": ">=0.0.5 <1.0.0",
    "@antelopejs/interface-core": ">=0.0.6 <1.0.0",
    "@antelopejs/interface-data-api": ">=0.1.5 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.3 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.1.4 <1.0.0"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.17.1",
    "@antelopejs/tooling-configs": "^0.2.17",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "knip": "^6.43.0",
    "mongodb-memory-server-core": "^11.3.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "test": "antelope.test.ts"
  }
}
