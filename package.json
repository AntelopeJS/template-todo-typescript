{
  "name": "antelopejs-module",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ajs project run -w",
    "test": "ajs module test",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync --profile template",
    "sync:check": "antelopejs-sync --check --profile template",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p tsconfig.config.json",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.3.5 <0.4.0",
    "@antelopejs/interface-auth": ">=0.2.2 <0.3.0",
    "@antelopejs/interface-core": ">=0.5.4 <0.6.0",
    "@antelopejs/interface-data-api": ">=0.8.3 <0.9.0",
    "@antelopejs/interface-database": ">=0.4.5 <0.5.0",
    "@antelopejs/interface-database-decorators": ">=0.5.4 <0.6.0"
  },
  "devDependencies": {
    "@antelopejs/core": "~1.24.9",
    "@antelopejs/tooling-configs": "^0.10.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/semver": "^7",
    "knip": "^6.46.1",
    "mongodb-memory-server-core": "^11.3.0",
    "oxfmt": "^0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.0"
  },
  "packageManager": "pnpm@10.34.9",
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "test": "antelope.test.ts"
  }
}
