{
  "name": "antelopejs-module",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ajs project run -w",
    "test": "ajs module test",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync --profile template",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check --profile template",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p tsconfig.config.json",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.3.0 <1.0.0",
    "@antelopejs/interface-auth": ">=0.2.0 <1.0.0",
    "@antelopejs/interface-core": ">=0.4.0 <1.0.0",
    "@antelopejs/interface-data-api": ">=0.6.1 <1.0.0",
    "@antelopejs/interface-database": ">=0.3.1 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.2.1 <1.0.0"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.21.0",
    "@antelopejs/tooling-configs": "^0.3.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "knip": "^6.44.1",
    "mongodb-memory-server-core": "^11.3.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "test": "antelope.test.ts"
  }
}
